# Cloudflare Pages headers, mirroring nginx.conf + security-headers.conf.
# Copied into dist by scripts/pages-dist.mjs (not public/, so the nginx image
# doesn't serve this file). Pages applies EVERY rule that matches a path and
# joins repeated headers, so the specific rules below detach the default
# Cache-Control ("! Cache-Control") before setting their own.

# Security headers on everything; HTML (/, /projects*, 404) and llms.txt revalidate
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: no-cache

# Vite's content-hashed files (js, css, the character model and HDR)
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: versioned by filename
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names across deploys: a week, then revalidate in the background
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Crawler files: an hour
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600

/resume.pdf
  ! Cache-Control
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
